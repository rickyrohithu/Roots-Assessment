# Server Port
PORT=5001

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/roots_management
# For production Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roots_management?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# Client URL (Allowed origin)
CLIENT_URL=http://localhost:5173
